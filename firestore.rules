
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL ADMIN OVERRIDE ---
    // Explicit master key for the primary administrator to bypass all collection rules.
    match /{allPaths=**} {
      allow read, write: if request.auth.uid == 'cgQheQMuxqZd4N825PppPl72GtE2';
    }

    /**
     * DECENT DUCKS SANCTUARY SECURITY RULES
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'decentducksorg@gmail.com' || 
        request.auth.token.email == 'flowmarket1@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Collection Rules ---

    match /birds/{birdId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /healthLogs/{logId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /egg_history/{date} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ledger/{expenseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /donations/{donationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /daily_status/{statusId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sanctuary_stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
    
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
    }

    match /nameSuggestions/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
