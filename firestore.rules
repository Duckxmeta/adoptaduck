
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * VIRTUAL SANCTUARY SECURITY MODEL
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'flowmarket1@gmail.com');
    }

    match /birds/{birdId} {
      allow read: if true;
      allow write: if isAdmin();

      match /healthLogs/{healthLogEntryId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /nameSuggestions/{suggestionId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /daily_status/{statusId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /sanctuaryStats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
