
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * DECENT DUCKS SANCTUARY SECURITY RULES
     * Version: 1.2.2 (Master UID Casing & Naming Alignment)
     * Last Updated: 2026-04-03
     */

    // --- MASTER OVERRIDE ---
    // Hard-locked to production owner UIDs. Casing must be exact.
    match /{allPaths=**} {
      allow read, write: if request.auth != null && (
        request.auth.uid == 'cgQHeQMuxqZd4N825PppPl72GtE2' ||
        request.auth.token.email == 'decentducksorg@gmail.com' || 
        request.auth.token.email == 'flowmarket1@gmail.com'
      );
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'decentducksorg@gmail.com' || 
        request.auth.token.email == 'flowmarket1@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Collection Rules ---

    match /bulletin/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /birds/{birdId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /healthLogs/{logId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /egg_history/{date} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ledger/{expenseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /donations/{donationId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /daily_status/{statusId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
    
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
    }

    match /naming_requests/{requestId} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    match /promo_codes/{codeId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
