
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- AUTH UTILITIES ---
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'flowmarket1@gmail.com' || 
        request.auth.token.email == 'decentducksorg@gmail.com' ||
        request.auth.uid == 'cgQHeQMuxqZd4N825PppPl72GtE2'
      );
    }
    
    function isGuardian() {
      return request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'guardian' || 
        isAdmin()
      );
    }

    // --- COLLECTION RULES ---

    match /birds/{birdId} {
      allow read: if true; // Public can see residents
      allow write: if isAdmin();
    }
    
    match /ledger/{expenseId} {
      allow read: if isGuardian();
      allow write: if isAdmin();
    }
    
    match /daily_status/{statusId} {
      allow read: if isGuardian();
      allow write: if isAdmin();
    }
    
    match /donations/{donationId} {
      allow read: if isGuardian();
      allow write: if isAdmin();
    }
    
    match /naming_requests/{requestId} {
      allow read: if isAdmin();
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }
    
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    match /promo_codes/{code} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // --- DEFAULT DENY ---
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
