rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Allow dual-admin access while keeping flowmarket1@gmail.com hidden from UI
      return isSignedIn() && (
        request.auth.token.email == 'decentducksorg@gmail.com' || 
        request.auth.token.email == 'flowmarket1@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /birds/{birdId} {
      allow read: if true;
      allow write: if isAdmin();

      match /healthLogs/{healthLogEntryId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /users/{userId} {
      // Allow users to manage their own profiles or admins to manage all profiles
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /nameSuggestions/{suggestionId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /daily_status/{statusId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /sanctuaryStats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}