rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * DECENT DUCKS SANCTUARY SECURITY MODEL
     * 
     * Core Philosophy:
     * This ruleset secures the sanctuary platform by strictly limiting administrative 
     * capabilities to a single authorized manager email: flowmarket1@gmail.com.
     */

    // --- HELPER FUNCTIONS ---

    /** @description Checks if the request is coming from a signed-in user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user's email matches the authorized sanctuary manager. */
    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == 'flowmarket1@gmail.com');
    }

    // --- COLLECTION RULES ---

    /**
     * @description Public bird profiles manageable only by the sanctuary manager.
     */
    match /birds/{birdId} {
      allow read: if true;
      allow write: if isAdmin();

      /**
       * @description Private health logs strictly restricted to the sanctuary manager.
       */
      match /healthLogs/{healthLogEntryId} {
        allow read, write: if isAdmin();
      }
    }

    /**
     * @description Aggregated sanctuary metrics for public real-time display.
     */
    match /sanctuaryStats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}