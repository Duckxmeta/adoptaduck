
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * DECENT DUCKS SANCTUARY SECURITY RULES
     * 
     * Core Philosophy:
     * - Public Read: Birds, Ledger (transparency), Donations (impact tracking), Daily Status, Settings.
     * - Member Read: Detailed Health Logs.
     * - Admin Write: Birds, Ledger, Daily Status, Settings, Sanctuary Stats.
     * - Public Create: Donations (recorded after PayPal success), Name Suggestions.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'decentducksorg@gmail.com' || 
        request.auth.token.email == 'flowmarket1@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // --- Collection Rules ---

    match /birds/{birdId} {
      allow read: if true;
      allow write: if isAdmin();
      
      match /healthLogs/{logId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /ledger/{expenseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /donations/{donationId} {
      allow read: if true;
      allow create: if true; // Record results after PayPal
      allow update, delete: if isAdmin();
    }

    match /daily_status/{statusId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sanctuary_stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }
    
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
    }

    match /nameSuggestions/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
