
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Use the email check but ensure it's available in the token
      return isSignedIn() && (request.auth.token.email == 'flowmarket1@gmail.com');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /birds/{birdId} {
      allow read: if true;
      allow write: if isAdmin();

      match /healthLogs/{healthLogEntryId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /users/{userId} {
      // 4. Permission Check: Ensure users can create and manage their own profile
      allow read, write: if isOwner(userId);
    }

    match /nameSuggestions/{suggestionId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /daily_status/{statusId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /sanctuaryStats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
