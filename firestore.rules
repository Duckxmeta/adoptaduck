rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * DECENT DUCKS SANCTUARY SECURITY RULES
     * 
     * Implementations:
     * 1. Dual-Admin Authorization: Access granted via email list or roles_admin collection.
     * 2. Public Transparency: Duck profiles are publicly readable.
     * 3. Member Privacy: User profiles and daily sanctuary status are restricted to signed-in members.
     * 4. Operational Security: Sensitive logs and database modifications are Admin-only.
     */

    // --- GLOBAL HELPER FUNCTIONS ---

    function isSignedIn() {
      return request.auth != null;
    }

    /** 
     * Checks if the user is one of the hardcoded administrators or 
     * exists in the roles_admin DBAC collection.
     */
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['decentducksorg@gmail.com', 'flowmarket1@gmail.com'] ||
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
      );
    }

    // --- COLLECTION RULES ---

    /** Admin Role assignments */
    match /roles_admin/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if false; 
    }

    /** Publicly viewable duck profiles */
    match /birds/{birdId} {
      allow get, list: if true;
      allow write: if isAdmin();

      /** Wellness and clinical logs (Admin-only) */
      match /healthLogs/{healthLogId} {
        allow get, list, write: if isAdmin();
      }
    }

    /** Global sanctuary routine status (Viewable by all members) */
    match /daily_status/{statusId} {
      allow get: if isSignedIn();
      allow write: if isAdmin();
    }

    /** User profiles and adopted flock links */
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
    }

    /** Community name suggestions from donors */
    match /nameSuggestions/{suggestionId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }
  }
}