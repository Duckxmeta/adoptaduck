
{
  "entities": {
    "Bird": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Bird",
      "type": "object",
      "description": "Represents a single resident duck or bird in the Decent Ducks Sanctuary.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "breed": { "type": "string" },
        "sex": { "type": "string" },
        "heritageTree": { "type": "string" },
        "eggCounter": { "type": "number" },
        "personalityTraits": { "type": "string" },
        "backstory": { "type": "string" },
        "primaryImageUrl": { "type": "string", "format": "uri" },
        "galleryImageUrls": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "breed", "sex", "eggCounter", "primaryImageUrl", "createdAt"]
    },
    "NameSuggestion": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "NameSuggestion",
      "type": "object",
      "description": "A donation-linked name suggestion for a sanctuary resident.",
      "properties": {
        "id": { "type": "string" },
        "birdId": { "type": "string" },
        "birdOriginalName": { "type": "string" },
        "suggestedName": { "type": "string" },
        "donorEmail": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["birdId", "suggestedName", "status", "createdAt"]
    },
    "DailyStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "DailyStatus",
      "type": "object",
      "description": "Daily sanctuary routine checklist status.",
      "properties": {
        "id": { "type": "string" },
        "morningFeeding": { "type": "boolean" },
        "freshWater": { "type": "boolean" },
        "eggCounter": { "type": "boolean" },
        "healthCheck": { "type": "boolean" },
        "nightlyPenUp": { "type": "boolean" },
        "lastReset": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous", "google"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/birds/{birdId}",
        "definition": {
          "entityName": "Bird",
          "schema": { "$ref": "#/backend/entities/Bird" },
          "description": "Public bird profiles."
        }
      },
      {
        "path": "/nameSuggestions/{suggestionId}",
        "definition": {
          "entityName": "NameSuggestion",
          "schema": { "$ref": "#/backend/entities/NameSuggestion" },
          "description": "Collection of pending and processed name suggestions from donors."
        }
      },
      {
        "path": "/daily_status/{statusId}",
        "definition": {
          "entityName": "DailyStatus",
          "schema": { "$ref": "#/backend/entities/DailyStatus" },
          "description": "Daily sanctuary routine tracking."
        }
      }
    ]
  }
}
