{
  "entities": {
    "ResidentBird": {
      "title": "ResidentBird",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "breed": { "type": "string" },
        "sex": { "type": "string", "enum": ["male", "female", "unknown"] },
        "eggCounter": { "type": "number" },
        "personalityTraits": { "type": "string" },
        "backstory": { "type": "string" },
        "primaryImageUrl": { "type": "string" },
        "isFoundingResident": { "type": "boolean" },
        "generation": { "type": "number" }
      }
    },
    "Donation": {
      "title": "Donation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "designation": { "type": "string", "enum": ["feed", "medical", "infrastructure"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "donorDisplayInfo": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/birds/{birdId}": {
      "schema": "#/backend/entities/ResidentBird",
      "description": "Sanctuary residents collection."
    },
    "/donations/{donationId}": {
      "schema": "#/backend/entities/Donation",
      "description": "Records of one-time financial support."
    },
    "/ledger/{expenseId}": {
      "description": "Transparency ledger for sanctuary spending."
    }
  }
}