
{
  "entities": {
    "ResidentBird": {
      "title": "ResidentBird",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "breed": { "type": "string" },
        "sex": { "type": "string", "enum": ["male", "female", "unknown"] },
        "personalityTraits": { "type": "string" },
        "backstory": { "type": "string" },
        "primaryImageUrl": { "type": "string" },
        "isFoundingResident": { "type": "boolean" },
        "generation": { "type": "number" }
      }
    },
    "EggHistory": {
      "title": "EggHistory",
      "type": "object",
      "description": "Daily egg production totals.",
      "properties": {
        "id": { "type": "string", "description": "Date formatted as YYYY-MM-DD" },
        "count": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Donation": {
      "title": "Donation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "amount": { "type": "number" },
        "designation": { "type": "string", "enum": ["feed", "medical", "infrastructure"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "donorDisplayName": { "type": "string", "description": "Public-facing name for the ledger." },
        "donorPrivateName": { "type": "string", "description": "Legal name from PayPal (Admin only)." },
        "donorPrivateEmail": { "type": "string", "description": "Email from PayPal (Admin only)." }
      }
    }
  },
  "auth": {
    "providers": ["password", "google"]
  },
  "firestore": {
    "/birds/{birdId}": {
      "schema": "#/backend/entities/ResidentBird",
      "description": "Sanctuary residents collection."
    },
    "/egg_history/{date}": {
      "schema": "#/backend/entities/EggHistory",
      "description": "Daily aggregate of egg collection."
    },
    "/donations/{donationId}": {
      "schema": "#/backend/entities/Donation",
      "description": "Records of financial support with privacy tiers."
    },
    "/ledger/{expenseId}": {
      "description": "Transparency ledger for sanctuary spending."
    }
  }
}
