{
  "entities": {
    "Bird": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Bird",
      "type": "object",
      "description": "Represents a virtual duck resident in the Decent Ducks Sanctuary.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "breed": { "type": "string" },
        "sex": { "type": "string" },
        "heritageTree": { "type": "string" },
        "eggCounter": { "type": "number" },
        "personalityTraits": { "type": "string" },
        "backstory": { "type": "string" },
        "primaryImageUrl": { "type": "string", "format": "uri" },
        "galleryImageUrls": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "breed", "sex", "eggCounter", "personalityTraits", "backstory", "primaryImageUrl", "createdAt"]
    },
    "HealthLogEntry": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "HealthLogEntry",
      "type": "object",
      "description": "Records health notes for a specific bird resident.",
      "properties": {
        "id": { "type": "string" },
        "birdId": { "type": "string" },
        "logDate": { "type": "string", "format": "date-time" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "birdId", "logDate", "notes", "createdAt"]
    },
    "DailyStatus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "DailyStatus",
      "type": "object",
      "description": "Represents the daily routine status of the sanctuary.",
      "properties": {
        "id": { "type": "string" },
        "morningFeeding": { "type": "boolean" },
        "freshWater": { "type": "boolean" },
        "eggCounter": { "type": "boolean" },
        "healthCheck": { "type": "boolean" },
        "nightlyPenUp": { "type": "boolean" },
        "lastReset": { "type": "string", "format": "date-time" }
      },
      "required": ["morningFeeding", "freshWater", "eggCounter", "healthCheck", "nightlyPenUp"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/roles_admin/{uid}",
        "definition": {
          "entityName": "AdminRole",
          "description": "Stores documents for authenticated administrators.",
          "params": [{ "name": "uid" }]
        }
      },
      {
        "path": "/birds/{birdId}",
        "definition": {
          "entityName": "Bird",
          "description": "Public duck resident profiles.",
          "params": [{ "name": "birdId" }]
        }
      },
      {
        "path": "/birds/{birdId}/healthLogs/{healthLogId}",
        "definition": {
          "entityName": "HealthLogEntry",
          "description": "Clinical and wellness logs for residents.",
          "params": [{ "name": "birdId" }, { "name": "healthLogId" }]
        }
      },
      {
        "path": "/daily_status/{statusId}",
        "definition": {
          "entityName": "DailyStatus",
          "description": "Daily sanctuary routine tracking.",
          "params": [{ "name": "statusId" }]
        }
      }
    ],
    "reasoning": "The structure uses a global admin role pattern and explicit collection paths to ensure security and efficient real-time updates."
  }
}